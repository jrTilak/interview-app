NODE_ENV=development
PORT=3000
APP_NAME=Interview App
APP_WEB_URL=http://localhost:5173
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173
API_DOCS_FILE_PATH=docs/api-info.md
SWAGGER_ENABLE=true

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=interview_app
DB_USERNAME=interview_app
DB_PASSWORD=interview_app
DB_CONNECT_TIMEOUT_MS=10000
DB_AUTO_MIGRATE=false
PGSSLMODE=disable

GEMINI_API_KEY=replace-with-a-google-gemini-api-key
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_STT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_MS=45000

AUDIO_SILENCE_MS=1800
AUDIO_MAX_BYTES=10485760
MEDIA_MAX_CHUNK_BYTES=524288
