# Application runtime mode: development, test, or production. Production also
# requires every realtime Socket.IO connection to send an allowed Origin.
NODE_ENV=development

# TCP port on which the NestJS server listens (1-65535).
PORT=3000

# Product name shown by authentication and API documentation, and reported to
# PostgreSQL as the connection's application name.
APP_NAME="Interview Desk"

# Public URL of the web client. Candidate share links are built from this URL.
APP_WEB_URL=http://localhost:5173

# Global path prefix for application and authentication routes. Do not include
# a leading or trailing slash; for example, `api` produces `/api/...` routes.
API_PREFIX=api

# Comma-separated browser origins allowed by HTTP CORS, Better Auth, and the
# realtime gateway. Each entry must be an exact origin: scheme, host, and port.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Markdown file used as the application OpenAPI description when docs are on.
# Relative paths are resolved from the server's working directory.
API_DOCS_FILE_PATH=docs/api-info.md

# Enables `/api-docs`, `/api-docs.json`, `/auth-docs`, and `/auth-docs.json`.
# Disable this on deployments where public API documentation is not required.
SWAGGER_ENABLE=true

# Enables the authenticated, process-wide `/api/__flags__` testing API. Keep
# this false outside controlled development or demonstration environments.
DEV_TOOLS_ENABLED=true

# Secret used by Better Auth to protect authentication state and sessions. Use
# at least 32 cryptographically random characters and never commit a real value.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public base URL through which clients reach this server's auth endpoints.
# Include the scheme, host, and port, but not the `/api/auth` path.
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL hostname or service name.
DB_HOST=localhost

# PostgreSQL TCP port (1-65535).
DB_PORT=5432

# PostgreSQL database that stores users, interviews, attempts, and transcripts.
DB_NAME=interview_desk

# PostgreSQL login role used by the server.
DB_USERNAME=interview_desk

# Password for `DB_USERNAME`. Use a strong secret outside local development.
DB_PASSWORD=interview_desk

# Maximum time in milliseconds to establish a database connection
# (1000-60000).
DB_CONNECT_TIMEOUT_MS=10000

# When true, applies checked-in Drizzle migrations during server startup. Leave
# false when migrations are managed separately by a deployment process.
DB_AUTO_MIGRATE=false

# PostgreSQL TLS mode. Use `disable` for a trusted local database, `no-verify`
# for encrypted connections without certificate validation, or `require`,
# `prefer`, `verify-ca`, or `verify-full` for validated TLS connections.
PGSSLMODE=disable

# Base URL of the local LLM service used to structure interview topics and
# generate live interviewer dialogue.
LOCAL_LLM_URL=http://127.0.0.1:8003

# Maximum duration in milliseconds for one LLM request (1000-120000).
LOCAL_LLM_TIMEOUT_MS=120000

# Base URL of the speech-to-text service used to transcribe candidate audio.
LOCAL_STT_URL=http://127.0.0.1:8002

# Maximum duration in milliseconds for one transcription request
# (1000-120000).
LOCAL_STT_TIMEOUT_MS=45000

# Base URL of the text-to-speech service used to create interviewer audio.
LOCAL_TTS_URL=http://127.0.0.1:8001

# Default voice identifier sent to the text-to-speech service.
LOCAL_TTS_VOICE=professional-default

# Maximum duration in milliseconds for one speech synthesis request
# (1000-120000).
LOCAL_TTS_TIMEOUT_MS=45000

# Inactivity duration in milliseconds after which an open microphone turn is
# automatically finalized (500-10000).
AUDIO_SILENCE_MS=1800

# Maximum buffered bytes for one candidate audio turn and the maximum payload
# sent to speech-to-text (1024-12582912 bytes).
AUDIO_MAX_BYTES=10485760

# Maximum bytes accepted in one optional camera or screen-share chunk
# (1024-1048576 bytes). Media streaming must also be enabled by a dev flag.
MEDIA_MAX_CHUNK_BYTES=524288
