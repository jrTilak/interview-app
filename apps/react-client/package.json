{
	"name": "@interview-app/react-client",
	"version": "0.1.0",
	"description": "Desktop PWA for creating and taking AI interviews.",
	"private": true,
	"type": "module",
	"scripts": {
		"api:generate": "orval --config ./orval.config.ts --fail-on-warnings",
		"build": "tsc -b && vite build",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "vitest",
		"typecheck": "tsc -b --pretty false"
	},
	"dependencies": {
		"@chakra-ui/react": "3.36.1",
		"@emotion/react": "11.14.0",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/instrument-sans": "5.3.0",
		"@mediapipe/tasks-vision": "1.0.1",
		"@tanstack/react-form": "1.33.3",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.18",
		"axios": "1.19.0",
		"lucide-react": "1.28.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"socket.io-client": "4.8.3",
		"zod": "4.4.3",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@tanstack/router-plugin": "1.168.23",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@types/node": "24.10.13",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.5",
		"jsdom": "30.0.1",
		"orval": "8.23.0",
		"typescript": "6.0.2",
		"vite": "8.2.0",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "4.1.10",
		"workbox-window": "7.4.1"
	}
}
