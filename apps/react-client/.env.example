# Leave blank for the built-in same-origin Vite/nginx proxy.
VITE_API_URL=

# Backend used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:3000

# NestJS application OpenAPI document used by Orval.
OPENAPI_SCHEMA_URL=http://localhost:3000/api-docs.json

# Better Auth OpenAPI document used by Orval.
AUTH_OPENAPI_SCHEMA_URL=http://localhost:3000/auth-docs.json
